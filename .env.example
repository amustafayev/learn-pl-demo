# Google Docs for class notes (see src/features/notes/googleDocs.js).
# Create an OAuth 2.0 "Web application" client in Google Cloud Console, enable the
# Google Drive API, add this site's origin (e.g. http://localhost:5173) under
# "Authorized JavaScript origins", then copy the client ID here as .env.local.
VITE_GOOGLE_CLIENT_ID=
